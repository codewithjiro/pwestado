# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ---- PWESTADO: secrets and local configuration (never commit) ----
# Mapbox tokens are passed with --dart-define; keep any local copies untracked.
.env
.env.*
*.env
dart_defines*.json
dart-defines*.json
secrets/
*.secret
**/local.properties
**/key.properties
**/*.keystore
**/*.jks
# Gradle may hold a Mapbox SDK_REGISTRY_TOKEN (sk.) if one is ever needed.
**/gradle.properties.local
.gradle/
# VS Code launch configs often embed --dart-define tokens.
.vscode/launch.json
.vscode/settings.local.json

# Local SQLite files (saved analyses live on the device, never in git)
*.db
*.db-journal

# Backend tooling (never commit local secrets or build state)
backend/**/node_modules/
backend/**/.wrangler/
backend/**/.dev.vars

# Private-demo Gemini API key (direct-key AI Insights). Never commit.
# Copy lib/core/config/gemini_local_key.example.dart to create it.
lib/core/config/gemini_local_key.dart
